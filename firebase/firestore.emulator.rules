rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ready() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /groups/{groupId} {
      allow get, list: if ready() && resource.data.status == 'ACTIVE'
        && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }
    match /_diagnostics/connectivity { allow get: if true; }
    // Claims, receipts, cleanup jobs and all financial/other product paths are private.
    match /{document=**} { allow read, write: if false; }
  }
}
