<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feature_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/feature_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/identity_brand"
            android:textSize="14sp"
            android:textColor="#30292A"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feature_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/identity_back"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <LinearLayout
            android:id="@+id/access_gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/access_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identity_checking"
                android:textSize="16sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/access_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/identity_refresh"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/access_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/identity_logout"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feature_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expenses_create_title"
                android:textSize="30sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/feature_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expenses_create_intro"
                android:textSize="16sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/expenses_item_title"
                android:layout_marginBottom="14dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expense_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:minHeight="56dp"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/expenses_amount"
                android:layout_marginBottom="14dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expense_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:minHeight="56dp"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expenses_payer"
                android:textSize="14sp"
                android:textColor="#30292A"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/expense_payer_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expenses_category"
                android:textSize="14sp"
                android:textColor="#30292A"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/expense_category_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/expenses_note"
                android:layout_marginBottom="14dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/expense_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:maxLength="1000"
                    android:minHeight="56dp"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/expenses_participants"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#30292A"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/expense_participants_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/split_method"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#30292A"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/expense_split_method_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/expense_split_inputs_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/split_values"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#30292A"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/expense_split_inputs_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/expense_split_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error_banner_background"
                android:textSize="14sp"
                android:accessibilityLiveRegion="polite"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/expense_split_preview_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/split_preview"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#30292A"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/expense_split_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/expense_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/expenses_add"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/identity_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/identity_retry"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <ProgressBar
                android:id="@+id/feature_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/feature_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identity_checking"
                android:textSize="16sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
