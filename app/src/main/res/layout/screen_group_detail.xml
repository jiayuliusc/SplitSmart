<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/feature_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/feature_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_brand" android:textSize="14sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/feature_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/identity_back" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <LinearLayout android:id="@+id/access_gate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/access_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_checking" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/access_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/identity_refresh" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/access_logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/identity_logout" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/feature_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/feature_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_details_title" android:textSize="30sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/feature_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_intro" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/groups_description_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_description" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/groups_role" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_member_label" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/groups_refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/identity_refresh" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <TextView android:id="@+id/groups_members_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_members" android:textSize="22sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
            <LinearLayout android:id="@+id/groups_members_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <LinearLayout android:id="@+id/groups_owner_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/groups_owner_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_owner_title" android:textSize="22sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
                <TextView android:id="@+id/groups_owner_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/groups_owner_intro" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/groups_name" android:layout_marginBottom="14dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:endIconMode="none">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/groups_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="100" android:minHeight="56dp" android:saveEnabled="false" android:importantForAutofill="auto" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/groups_description" android:layout_marginBottom="14dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:endIconMode="none">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/groups_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine" android:maxLength="1000" android:minHeight="56dp" android:saveEnabled="false" android:importantForAutofill="auto" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/groups_save" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/groups_save" android:textAllCaps="false" android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/identity_email" android:layout_marginBottom="14dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" app:endIconMode="none">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/groups_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLength="254" android:minHeight="56dp" android:saveEnabled="true" android:importantForAutofill="auto" android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/groups_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/groups_add" android:textAllCaps="false" android:layout_marginBottom="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/groups_delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/groups_delete" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/identity_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/identity_retry" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <ProgressBar android:id="@+id/feature_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone"/>
            <TextView android:id="@+id/feature_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_checking" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
