<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/feature_back" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_back" android:textAllCaps="false" android:letterSpacing="0" />
        <LinearLayout android:id="@+id/access_gate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/access_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_checking" android:textColor="@color/balance_muted" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/access_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_refresh" android:textAllCaps="false" android:letterSpacing="0" />
            <com.google.android.material.button.MaterialButton android:id="@+id/access_logout" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_logout" android:textAllCaps="false" android:letterSpacing="0" />
        </LinearLayout>
        <LinearLayout android:id="@+id/feature_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/balances_group_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_muted" android:textSize="14sp" android:layout_marginTop="16dp" />
            <TextView android:id="@+id/balances_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_title" android:textColor="@color/balance_ink" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_intro" android:textColor="@color/balance_muted" android:textSize="16sp" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />
            <ProgressBar android:id="@+id/feature_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" />
            <TextView android:id="@+id/feature_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_muted" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:id="@+id/balances_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/balance_card" android:padding="24dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_owe" android:textColor="@color/balance_muted" android:textSize="14sp" />
                    <TextView android:id="@+id/balances_owe_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_owe" android:textSize="32sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp" android:layout_marginBottom="20dp" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="14sp" app:autoSizeMaxTextSize="32sp" app:autoSizeStepGranularity="1sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/balance_line" android:layout_marginBottom="20dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_receive" android:textColor="@color/balance_muted" android:textSize="14sp" />
                    <TextView android:id="@+id/balances_receive_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_receive" android:textSize="32sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp" android:layout_marginBottom="0dp" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="14sp" app:autoSizeMaxTextSize="32sp" app:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/balances_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:visibility="gone">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_zero" android:textColor="@color/balance_ink" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:id="@+id/balances_empty_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_zero_detail" android:textColor="@color/balance_muted" android:textSize="14sp" android:layout_marginTop="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/balances_people_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_people" android:textColor="@color/balance_ink" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" />
                <LinearLayout android:id="@+id/balances_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/balances_settlements_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_settlements" android:textColor="@color/balance_ink" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/balances_settlements_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_settlements_empty" android:textColor="@color/balance_muted" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:id="@+id/balances_settlements_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/balances_add_settlement" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/balances_add_settlement" android:textAllCaps="false" android:letterSpacing="0" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/balances_expenses_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_expenses" android:textColor="@color/balance_ink" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" />
                <TextView android:id="@+id/balances_expenses_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_expenses_empty" android:textColor="@color/balance_muted" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:id="@+id/balances_expenses_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.button.MaterialButton android:id="@+id/balances_add_expense" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/balances_add_expense" android:textAllCaps="false" android:letterSpacing="0" android:layout_marginTop="12dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/balances_note" android:textColor="@color/balance_muted" android:textSize="13sp" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/balances_refresh" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/balances_refresh" android:textAllCaps="false" android:letterSpacing="0" android:layout_marginTop="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
