<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feature_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <!-- Required by FeatureScreen.screen() and ProtectedScreen.protect(): keep these IDs. -->
        <com.google.android.material.button.MaterialButton android:id="@+id/feature_back" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_back" android:textAllCaps="false" android:letterSpacing="0" />
        <LinearLayout android:id="@+id/access_gate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/access_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/identity_checking" android:textColor="@color/balance_muted" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/access_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_refresh" android:textAllCaps="false" android:letterSpacing="0" />
            <com.google.android.material.button.MaterialButton android:id="@+id/access_logout" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/identity_logout" android:textAllCaps="false" android:letterSpacing="0" />
        </LinearLayout>

        <LinearLayout android:id="@+id/feature_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/settlement_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_settlement_title" android:textColor="@color/balance_ink" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="16dp" />
            <ProgressBar android:id="@+id/feature_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:visibility="gone" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/feature_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_muted" android:textSize="16sp" android:accessibilityLiveRegion="polite" />

            <LinearLayout android:id="@+id/settlement_detail_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
                <TextView android:id="@+id/settlement_detail_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_ink" android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="20dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_label_paid_by" android:textColor="@color/balance_muted" android:textSize="13sp" />
                <TextView android:id="@+id/settlement_detail_payer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_ink" android:textSize="18sp" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_label_paid_to" android:textColor="@color/balance_muted" android:textSize="13sp" />
                <TextView android:id="@+id/settlement_detail_payee" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_ink" android:textSize="18sp" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_label_date" android:textColor="@color/balance_muted" android:textSize="13sp" />
                <TextView android:id="@+id/settlement_detail_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_ink" android:textSize="18sp" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_label_note" android:textColor="@color/balance_muted" android:textSize="13sp" />
                <TextView android:id="@+id/settlement_detail_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/balance_ink" android:textSize="18sp" android:layout_marginBottom="24dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton android:id="@+id/settlement_detail_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/history_edit_settlement" android:textAllCaps="false" android:letterSpacing="0" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
