<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/feature_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/feature_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/identity_brand"
            android:textSize="14sp"
            android:textColor="#30292A"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feature_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="@string/identity_back"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <LinearLayout
            android:id="@+id/access_gate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/access_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identity_checking"
                android:textSize="16sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/access_retry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/identity_refresh"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/access_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/identity_logout"
                android:textAllCaps="false"
                android:layout_marginBottom="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feature_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settlement_create_title"
                android:textSize="30sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/feature_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settlement_intro"
                android:textSize="16sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />

            <TextView android:id="@+id/settlement_payer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#30292A" android:layout_marginBottom="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settlement_payee" android:labelFor="@id/settlement_payee_spinner" android:textSize="14sp" android:textColor="#30292A" />
            <Spinner android:id="@+id/settlement_payee_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/settlement_limit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#655B5C" android:accessibilityLiveRegion="polite" android:layout_marginBottom="16dp" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/settlement_amount" android:layout_marginBottom="14dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/settlement_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:minHeight="56dp" android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/settlement_note" android:layout_marginBottom="20dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/settlement_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:maxLength="1000" android:minHeight="56dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/settlement_submit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/settlement_save" android:textAllCaps="false" android:backgroundTint="#990000" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settlement_delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/settlement_delete" android:textAllCaps="false" android:textColor="#990000" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/identity_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/identity_retry" android:textAllCaps="false" android:layout_marginBottom="8dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            <ProgressBar
                android:id="@+id/feature_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/feature_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/identity_checking"
                android:textSize="16sp"
                android:textColor="#30292A"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
