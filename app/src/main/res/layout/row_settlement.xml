<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EAE3DE" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="12dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/settlement_row_names" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#30292A" />
            <TextView android:id="@+id/settlement_row_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#655B5C" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/settlement_row_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#655B5C" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/settlement_row_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:textColor="#30292A" android:layout_marginTop="6dp" />
        </LinearLayout>
        <ImageButton android:id="@+id/settlement_row_edit" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_settlement_edit" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/settlement_edit_description" />
    </LinearLayout>
</LinearLayout>
